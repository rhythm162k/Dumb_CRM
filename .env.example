NODE_ENV=development
PORT=4000
# local Docker database (port 5433, see docker-compose.yml)
DATABASE_URL=postgresql://crm:crm@localhost:5433/crm
# hosted databases (Supabase etc.): require
DATABASE_SSL=off
DB_POOL_MAX=10
WEB_ORIGIN=http://localhost:5173
# reverse proxies in front of the API (1 = only Render's; a rewrite proxy in front of it makes it 2)
TRUST_PROXY=1
DEBUG_CLIENT_IP=false

# generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# 12 locally; 10 is the floor allowed in production (bcryptjs is slow on small free instances)
BCRYPT_COST=12
REQUIRE_EMAIL_VERIFICATION=false

# Email (Resend). Leave RESEND_API_KEY empty to print emails in the API console (dev only;
# in production nothing is printed, so reset and verification emails need a real key).
RESEND_API_KEY=
EMAIL_FROM=Crm <onboarding@resend.dev>

# Google sign-in (optional). The redirect URI goes through the web origin so cookies stay first-party.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# web build (apps/web), set on the static host: the API's own address, used by the splash screen
# VITE_API_URL=https://your-api.onrender.com
